page {
  background: #0b1220;
  color: #edf4ff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

view,
text,
button,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 70rpx;
  background: radial-gradient(circle at 92% -6%, #1d3557 0, #0b1220 44%);
}

.muted {
  color: #92a5c0;
}

.section-title {
  color: #edf4ff;
  font-size: 34rpx;
  font-weight: 700;
}

.pill {
  border: 1rpx solid #263b5a;
  border-radius: 999rpx;
  color: #9fb3ce;
  font-size: 22rpx;
  padding: 10rpx 18rpx;
}
