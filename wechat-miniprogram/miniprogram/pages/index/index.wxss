.hero { padding: 20rpx 4rpx 34rpx; }
.eyebrow { color: #49d6bd; font-size: 18rpx; letter-spacing: 3rpx; }
.hero-title { color: #f2f7ff; font-size: 72rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1.16; margin-top: 20rpx; }
.hero-accent { color: #73a7ff; }
.hero-subtitle { color: #9db0c9; font-size: 26rpx; line-height: 1.6; margin-top: 18rpx; }
.hero-meta { color: #6f86a5; display: flex; font-size: 21rpx; gap: 28rpx; margin-top: 22rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.metric { background: rgba(20, 36, 59, .88); border: 1rpx solid #263b5a; border-radius: 18rpx; padding: 22rpx; }
.metric-label, .metric-hint, .metric-caption { color: #8298b5; display: block; font-size: 20rpx; }
.metric-value { color: #eef5ff; display: block; font-size: 42rpx; font-weight: 750; margin-top: 8rpx; }
.metric-hint { color: #49d6bd; font-size: 18rpx; margin-top: 4rpx; }
.positive { color: #49d6bd !important; }
.muted { color: #8298b5 !important; }
.section-head { align-items: baseline; display: flex; justify-content: space-between; margin: 42rpx 2rpx 18rpx; }
.section-title { font-size: 36rpx; }
.section-link { color: #73a7ff; font-size: 22rpx; }
.mode-tabs { display: flex; gap: 12rpx; }
.mode-tab { background: #101d31; border: 1rpx solid #263b5a; border-radius: 999rpx; color: #91a5c2; font-size: 24rpx; line-height: 1; margin: 0; padding: 17rpx 28rpx; }
.mode-tab.active { background: #1b3152; border-color: #73a7ff; color: #f3f8ff; }
.module-tabs { margin: 24rpx -28rpx 14rpx; white-space: nowrap; }
.module-tab-row { display: inline-flex; gap: 12rpx; padding: 0 28rpx 10rpx; }
.module-tab { align-items: center; background: rgba(16, 29, 49, .9); border: 1rpx solid #263b5a; border-radius: 999rpx; color: #91a5c2; display: inline-flex; font-size: 22rpx; gap: 10rpx; padding: 14rpx 18rpx; }
.module-tab.active { background: #1b3152; border-color: var(--tab-color); color: #fff; }
.tab-dot { border-radius: 50%; height: 12rpx; width: 12rpx; }
.module-list { display: flex; flex-direction: column; gap: 18rpx; }
.module-card { background: rgba(16, 29, 49, .9); border: 1rpx solid #263b5a; border-left: 6rpx solid #73a7ff; border-radius: 18rpx; padding: 22rpx 18rpx; }
.module-head { align-items: center; display: flex; justify-content: space-between; }
.module-label { color: #73a7ff; font-family: monospace; font-size: 20rpx; margin-right: 12rpx; }
.module-title { color: #eef5ff; font-size: 31rpx; font-weight: 700; }
.sample-count { border: 1rpx solid #263b5a; border-radius: 999rpx; color: #8398b5; font-size: 18rpx; padding: 7rpx 12rpx; }
.module-note { color: #8095b0; font-size: 20rpx; line-height: 1.5; margin: 10rpx 0 14rpx 34rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rank-row { align-items: center; border-top: 1rpx solid rgba(38, 59, 90, .65); display: grid; gap: 8rpx; grid-template-columns: 42rpx minmax(0, 1fr) 70rpx 82rpx 68rpx; padding: 20rpx 0 8rpx; }
.rank-no { color: #6f86a5; font-family: monospace; font-size: 29rpx; text-align: center; }
.rank-no.top { color: #ffd36c; }
.rank-main { min-width: 0; }
.rank-name { color: #f1f6ff; font-size: 24rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.priority { background: #22334b; border-radius: 5rpx; color: #9db3d0; font-size: 15rpx; font-weight: 400; margin-left: 8rpx; padding: 3rpx 6rpx; }
.rank-meta { color: #7187a4; font-size: 17rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.progress { background: #20314a; border-radius: 9rpx; height: 5rpx; margin-top: 12rpx; overflow: hidden; }
.progress view { border-radius: inherit; height: 100%; }
.rank-metric, .rank-score { text-align: right; }
.rank-metric text:first-child, .rank-score text:first-child { color: #edf4ff; display: block; font-size: 21rpx; white-space: nowrap; }
.rank-score text:first-child { color: #ffbd69; }
.metric-caption { font-size: 16rpx; margin-top: 4rpx; }
.empty { border-top: 1rpx solid #263b5a; color: #8298b5; font-size: 21rpx; padding-top: 20rpx; }
.footer { color: #657c9b; display: flex; font-size: 18rpx; justify-content: space-between; margin-top: 34rpx; }
